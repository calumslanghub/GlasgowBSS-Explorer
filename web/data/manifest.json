{
 "layers": {
  "flows_intro": {
   "file": "system_profile.json",
   "scope": "global",
   "field": "kpi",
   "render": "text",
   "title": "How Glasgow used its bike share",
   "body": "About {weekday_per_day} trips a weekday, with morning and evening commuter peaks; {weekend_per_day} a weekend day, peaking in the afternoon. Click a station for its top destinations and origins, or press play to watch an average day."
  },
  "system_kpi": {
   "file": "system_profile.json",
   "scope": "global",
   "field": "kpi",
   "render": "kpi",
   "show_if": {
    "station": false
   },
   "title": "Weekdays vs weekends",
