    {
     "key": "weekday_per_day",
     "label": "Trips per weekday",
     "dp": 0,
     "colour": "#4b3f8f"
    },
    {
     "key": "weekend_per_day",
     "label": "Trips per weekend day",
     "dp": 0,
     "colour": "#e8871e"
    },
    {
     "key": "weekday_peak_hour",
     "label": "Weekday peak hour",
     "dp": 0,
     "unit": ":00",
     "colour": "#4b3f8f"
    },
    {
     "key": "weekend_peak_hour",
     "label": "Weekend peak hour",
     "dp": 0,
     "unit": ":00",
     "colour": "#e8871e"
    }
   ]
  },
  "system_hourly": {
